{
  "name": "realtime-voice-translation",
  "version": "0.1.0",
  "description": "实时语音翻译应用 - 支持多人会议和一对一实时聊天",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:optimize": "tsc && vite build --mode production",
    "build:full": "node scripts/build.js build",
    "build:check": "node scripts/build.js check",
    "build:clean": "node scripts/build.js clean",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:debug": "tauri build --debug",
    "bundle:analyze": "npm run build -- --mode analyze",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --grep 'Property'"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.9",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "fast-check": "^3.15.1",
    "jsdom": "^23.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  }
}
